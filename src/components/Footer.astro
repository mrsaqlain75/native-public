---
import site from "../data/site.json";
import { waLink } from "../lib/links";

const year = new Date().getFullYear();
const hrefs = [
  { label: "Call", href: `tel:${site.phoneHref}`, value: site.phoneDisplay },
  { label: "WhatsApp", href: waLink(site.whatsappNumber, "Hi! I have a question about Native."), value: site.phoneDisplay },
  { label: "Email", href: `mailto:${site.email}`, value: site.email },
];
const nav = [
  { href: "/menu/", label: "Menu" },
  { href: "/camping/", label: "Camping" },
  { href: "/gallery/", label: "Gallery" },
  { href: "/about/", label: "About" },
  { href: "/contact/", label: "Contact" },
];
---

<footer class="bg-ink text-bone">
  <div class="container-site py-16 md:py-20">
    <p class="font-display text-3xl leading-tight md:text-4xl">
      {site.name}
    </p>
    <p class="mt-3 max-w-md text-sm text-bone/70">{site.tagline}</p>

    <div class="mt-10 grid gap-10 border-t border-bone/15 pt-10 md:grid-cols-3">
      <ul class="space-y-1 text-sm">
        {hrefs.map((h) => (
          <li class="flex items-baseline justify-between gap-4 border-b border-bone/10 py-3">
            <span class="font-display text-base">{h.label}</span>
            <a class="text-bone/80 transition-colors hover:text-clay" href={h.href}>{h.value}</a>
          </li>
        ))}
        <li class="flex items-baseline justify-between gap-4 border-b border-bone/10 py-3">
          <span class="font-display text-base">Address</span>
          <span class="text-right text-bone/80">{site.address}</span>
        </li>
      </ul>

      <ul class="space-y-1 text-sm">
        {site.hours.map((h) => (
          <li class="flex items-baseline justify-between gap-4 border-b border-bone/10 py-3">
            <span class="font-display text-base">{h.days}</span>
            <span class="text-bone/80">{h.time}</span>
          </li>
        ))}
      </ul>

      <nav class="text-sm" aria-label="Footer">
        <ul class="space-y-1">
          {nav.map((l) => (
            <li>
              <a class="border-b border-transparent py-2 transition-colors hover:text-clay" href={l.href}>
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <p class="mt-10 border-t border-bone/15 pt-6 text-xs text-bone/50">
      © {year} {site.name}
    </p>
  </div>
</footer>
