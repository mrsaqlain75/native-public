---
import site from "../data/site.json";
import { waLink } from "../lib/links";
import LogoMark from "./LogoMark.astro";

const year = new Date().getFullYear();
const nav = [
  { href: "/menu/", label: "Menu" },
  { href: "/camping/", label: "Camping" },
  { href: "/gallery/", label: "Gallery" },
  { href: "/about/", label: "About" },
  { href: "/contact/", label: "Contact" },
];
const contactRows = [
  { label: "Call", href: `tel:${site.phoneHref}`, value: site.phoneDisplay },
  { label: "WhatsApp", href: waLink(site.whatsappNumber, "Hi Native!"), value: site.phoneDisplay },
  { label: "Email", href: `mailto:${site.email}`, value: site.email },
  { label: "Directions", href: `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.mapsQuery)}`, value: "Google Maps" },
];
---

<footer class="bg-ink text-bone">
  <div class="container-site py-16 md:py-24">
    <div class="grid gap-12 md:grid-cols-12 md:gap-10">
      <!-- Brand -->
      <div class="md:col-span-5">
        <a href="/" class="inline-flex items-center gap-4" aria-label={`${site.name}, home`}>
          <LogoMark class="h-10 w-auto md:h-12" />
          <span class="flex flex-col leading-none">
            <span class="font-display text-2xl tracking-tight md:text-3xl">Native</span>
            <span class="mt-1.5 font-body text-xs font-semibold tracking-wide text-bone/70">Resort &amp; Restaurant</span>
          </span>
        </a>
        <p class="mt-5 max-w-sm text-sm leading-relaxed text-bone/70">{site.tagline}</p>
        <p class="mt-4 max-w-sm text-sm text-bone/70">{site.address}</p>
        <p class="mt-4 font-display text-lg text-clay">Open 24 hours, 7 days a week</p>
      </div>

      <!-- Explore -->
      <nav class="md:col-span-3" aria-label="Footer">
        <h2 class="font-body text-sm font-semibold text-bone/50">Explore</h2>
        <ul class="mt-5 space-y-0 border-t border-bone/15">
          {nav.map((l) => (
            <li>
              <a
                href={l.href}
                class="block border-b border-bone/15 py-3.5 font-display text-lg transition-colors hover:text-clay"
              >
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Reach us -->
      <div class="md:col-span-4">
        <h2 class="font-body text-sm font-semibold text-bone/50">Reach us</h2>
        <ul class="mt-5 space-y-0 border-t border-bone/15">
          {contactRows.map((c) => (
            <li>
              <a
                href={c.href}
                class="flex items-baseline justify-between gap-4 border-b border-bone/15 py-3.5 transition-colors hover:text-clay"
              >
                <span class="font-display text-lg">{c.label}</span>
                <span class="text-sm text-bone/70">{c.value}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-14 flex flex-wrap items-center justify-between gap-4 border-t border-bone/15 pt-6">
      <p class="text-xs text-bone/50">© {year} {site.name}</p>
      <div class="flex gap-5 text-xs text-bone/50">
        {site.socials.instagram && <a href={site.socials.instagram} class="transition-colors hover:text-clay">Instagram</a>}
        {site.socials.facebook && <a href={site.socials.facebook} class="transition-colors hover:text-clay">Facebook</a>}
        {site.socials.youtube && <a href={site.socials.youtube} class="transition-colors hover:text-clay">YouTube</a>}
      </div>
    </div>
  </div>
</footer>
