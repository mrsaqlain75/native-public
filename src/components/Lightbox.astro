<!-- Full-screen image viewer for the gallery. Hidden until a photo is clicked. -->
<div
  id="lightbox"
  class="fixed inset-0 z-[70] flex items-center justify-center bg-ink/95 p-5 opacity-0 invisible transition-all duration-300"
  role="dialog"
  aria-modal="true"
  aria-label="Image viewer"
>
  <button
    id="lightbox-close"
    class="absolute right-4 top-4 z-10 flex h-12 w-12 items-center justify-center text-bone transition-colors hover:text-clay md:right-6 md:top-6"
    aria-label="Close image viewer"
  >
    <svg viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M6 6l12 12M18 6L6 18" />
    </svg>
  </button>
  <figure class="flex max-h-full max-w-full flex-col items-center">
    <img id="lightbox-img" class="max-h-[82vh] max-w-full object-contain" alt="" />
    <figcaption id="lightbox-cap" class="mt-4 max-w-xl text-center text-sm text-bone/80"></figcaption>
  </figure>
</div>

<script>
  const lb = document.getElementById("lightbox")!;
  const lbImg = document.getElementById("lightbox-img") as HTMLImageElement;
  const lbCap = document.getElementById("lightbox-cap")!;

  const setOpen = (open: boolean) => {
    lb.classList.toggle("opacity-0", !open);
    lb.classList.toggle("invisible", !open);
    document.body.style.overflow = open ? "hidden" : "";
  };

  for (const btn of document.querySelectorAll<HTMLElement>("[data-lightbox]")) {
    btn.addEventListener("click", () => {
      const full = btn.dataset.lightbox!;
      const cap = btn.dataset.cap || "";
      lbImg.src = full;
      lbImg.alt = cap;
      lbCap.textContent = cap;
      setOpen(true);
    });
  }

  document.getElementById("lightbox-close")!.addEventListener("click", () => setOpen(false));
  lb.addEventListener("click", (e) => {
    if (e.target === lb) setOpen(false);
  });
  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setOpen(false);
  });
</script>
