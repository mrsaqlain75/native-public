---
import site from "../data/site.json";

const links = [
  { href: "/", label: "Home" },
  { href: "/menu/", label: "Menu" },
  { href: "/camping/", label: "Camping" },
  { href: "/gallery/", label: "Gallery" },
  { href: "/about/", label: "About" },
  { href: "/contact/", label: "Contact" },
];
const { pathname } = Astro.url;
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href.replace(/\/$/, ""));
---

<header id="site-nav" class="fixed inset-x-0 top-0 z-50 text-bone transition-colors duration-300">
  <div class="container-site flex h-16 items-center justify-between gap-6 md:h-20">
    <a href="/" class="flex items-center gap-3" aria-label={`${site.name}, home`}>
      <img src="/favicon.svg" alt="" class="h-9 w-9 md:h-10 md:w-10" width="40" height="40" />
      <span class="font-display text-lg tracking-tight md:text-xl">
        {site.shortName}
        <span class="hidden text-[0.65em] align-super sm:inline">· restaurant &amp; camping</span>
      </span>
    </a>

    <nav class="hidden items-center gap-7 text-sm font-medium md:flex" aria-label="Main">
      {links.map((l) => (
        <a
          href={l.href}
          aria-current={isActive(l.href) ? "page" : undefined}
          class:list={[
            "border-b border-transparent py-1 transition-colors hover:border-current",
            isActive(l.href) ? "border-clay text-clay" : "",
          ]}
        >
          {l.label}
        </a>
      ))}
      <a
        href={`tel:${site.phoneHref}`}
        class="rounded-none border border-current px-4 py-2 font-semibold transition-colors hover:bg-bone hover:text-ink"
      >
        Reserve
      </a>
    </nav>

    <button
      id="menu-toggle"
      class="flex h-11 w-11 items-center justify-center md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
    >
      <svg viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" id="icon-open" />
        <path d="M6 6l12 12M18 6L6 18" id="icon-close" class="hidden" />
      </svg>
    </button>
  </div>

  <!-- Mobile menu: full-screen, dark, editorial -->
  <div
    id="mobile-menu"
    class="fixed inset-0 z-40 flex flex-col bg-ink text-bone opacity-0 invisible transition-all duration-300 md:hidden"
    aria-hidden="true"
  >
    <nav class="container-site flex grow flex-col pt-24" aria-label="Mobile">
      <ul>
        {links.map((l, i) => (
          <li>
            <a
              href={l.href}
              aria-current={isActive(l.href) ? "page" : undefined}
              class:list={[
                "flex items-baseline gap-4 border-b border-bone/10 py-4",
                isActive(l.href) ? "text-clay" : "",
              ]}
            >
              <span class="font-body text-xs font-semibold text-clay">{String(i + 1).padStart(2, "0")}</span>
              <span class="font-display text-3xl">{l.label}</span>
            </a>
          </li>
        ))}
      </ul>

      <div class="mt-auto pb-10">
        <a href={`tel:${site.phoneHref}`} class="block border border-bone/40 py-4 text-center font-display text-xl">
          Reserve · {site.phoneDisplay}
        </a>
        <p class="mt-4 text-center text-sm text-bone/60">Open 24 hours, 7 days a week</p>
      </div>
    </nav>
  </div>
</header>

<style>
  #site-nav[data-scrolled="true"] {
    background: var(--color-bone);
    color: var(--color-ink);
    border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 15%, transparent);
  }
</style>

<script>
  const nav = document.getElementById("site-nav")!;
  const toggle = document.getElementById("menu-toggle")!;
  const panel = document.getElementById("mobile-menu")!;
  const iconOpen = document.getElementById("icon-open")!;
  const iconClose = document.getElementById("icon-close")!;

  const onScroll = () => {
    if (!document.body.dataset.menuOpen) nav.dataset.scrolled = String(window.scrollY > 24);
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  const setMenu = (open: boolean) => {
    panel.classList.toggle("opacity-0", !open);
    panel.classList.toggle("invisible", !open);
    panel.setAttribute("aria-hidden", String(!open));
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    iconOpen.classList.toggle("hidden", open);
    iconClose.classList.toggle("hidden", !open);
    if (open) {
      document.body.dataset.menuOpen = "true";
      document.body.style.overflow = "hidden";
      nav.dataset.scrolled = "false";
    } else {
      delete document.body.dataset.menuOpen;
      document.body.style.overflow = "";
      onScroll();
    }
  };

  toggle.addEventListener("click", () => setMenu(panel.classList.contains("invisible")));
  panel.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setMenu(false)));
  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !panel.classList.contains("invisible")) setMenu(false);
  });
</script>
