---
import Layout from "../layouts/Layout.astro";
import PageHead from "../components/PageHead.astro";
import FaqSection from "../components/FaqSection.astro";
import site from "../data/site.json";
import camping from "../data/camping.json";
import images from "../data/images.json";
import faqs from "../data/faqs.json";
import { waLink } from "../lib/links";

const description = "Camp on the meadow at Native: bell tents with real beds, bonfire wood by the basket, and a kitchen downstairs. Packages, amenities and the practical details.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Campground",
    name: `${site.name} campsite`,
    description,
    telephone: site.phoneHref,
    address: { "@type": "PostalAddress", streetAddress: site.address },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [...faqs.camping, ...camping.goodToKnow].map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<Layout title="Camping" description={description} schema={schema}>
  <PageHead
    title="Camping &amp; Tents"
    lede="A handful of tents on the meadow behind the kitchen. One gate, staff awake all night, and a fire in the middle of it."
    image={images.pages.camping}
  />

  <section class="container-site py-16 md:py-24">
    <div class="flex items-baseline justify-between gap-6 border-b border-ink/15 pb-3">
      <h2 class="font-display text-2xl md:text-3xl">Our packages</h2>
      <span class="text-sm text-ink-soft">{camping.packages.length} ways to stay</span>
    </div>

    <ul class="border-t-0">
      {camping.packages.map((p) => (
        <li class="grid gap-6 border-b border-ink/15 py-10 md:grid-cols-12 md:items-center md:gap-10">
          <img src={p.img} alt={p.alt} class="aspect-[4/3] w-full object-cover md:col-span-5" loading="lazy" />
          <div class="md:col-span-7">
            <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
              <h3 class="font-display text-2xl md:text-3xl">{p.name}</h3>
              <span class="text-sm text-ink-soft">{p.capacity}</span>
            </div>
            <p class="mt-2">
              <span class="font-display text-2xl text-clay">{p.price}</span>
              <span class="ml-2 text-sm text-ink-soft">{p.unit}</span>
            </p>
            <ul class="mt-4 grid gap-x-6 gap-y-1 text-sm text-ink-soft sm:grid-cols-2">
              {p.includes.map((inc) => <li>{inc}</li>)}
            </ul>
          </div>
        </li>
      ))}
    </ul>

    <div class="mt-12 flex flex-wrap items-center gap-x-5 gap-y-4 border-t border-ink/15 pt-10">
      <a
        href={waLink(site.whatsappNumber, "Hi! I would like to book a campsite.")}
        class="bg-clay px-8 py-4 text-sm font-bold tracking-wide text-bone transition-colors hover:bg-clay-deep"
      >
        Book on WhatsApp
      </a>
      <a
        href={`tel:${site.phoneHref}`}
        class="border border-ink/50 px-8 py-4 text-sm font-bold tracking-wide text-ink transition-colors hover:bg-ink hover:text-bone"
      >
        Call {site.phoneDisplay}
      </a>
    </div>
  </section>

  <section class="container-site pb-16 md:pb-24">
    <div class="flex items-baseline justify-between gap-6 border-b border-ink/15 pb-3">
      <h2 class="font-display text-2xl md:text-3xl">What is here</h2>
      <span class="text-sm text-ink-soft">Amenities</span>
    </div>
    <ul class="mt-8 grid gap-x-12 border-t border-ink/15 md:grid-cols-2">
      {camping.amenities.map((a) => (
        <li class="border-b border-ink/15 py-4 text-ink-soft">{a}</li>
      ))}
    </ul>
  </section>

  <section class="container-site pb-16 md:pb-24">
    <div class="flex items-baseline justify-between gap-6 border-b border-ink/15 pb-3">
      <h2 class="font-display text-2xl md:text-3xl">Good to know</h2>
    </div>
    <div class="mt-8 border-t border-ink/15">
      {camping.goodToKnow.map((f) => (
        <details class="group border-b border-ink/15">
          <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-6 py-5 text-left font-display text-lg md:text-xl [&::-webkit-details-marker]:hidden">
            {f.q}
            <svg viewBox="0 0 24 24" class="h-5 w-5 shrink-0 text-clay transition-transform group-open:rotate-45" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M12 5v14M5 12h14" />
            </svg>
          </summary>
          <p class="max-w-2xl pb-6 text-ink-soft">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <FaqSection faqs={faqs.camping} title="Camping questions" />
</Layout>
