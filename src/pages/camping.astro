---
import Layout from "../layouts/Layout.astro";
import PageHead from "../components/PageHead.astro";
import FaqSection from "../components/FaqSection.astro";
import site from "../data/site.json";
import camping from "../data/camping.json";
import images from "../data/images.json";
import faqs from "../data/faqs.json";
import { waLink } from "../lib/links";

const description = "Camp on the meadow at Native: bell tents with real beds, bonfire wood by the basket, and a kitchen downstairs. Packages, amenities and the practical details.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Campground",
    name: `${site.name} campsite`,
    description,
    telephone: site.phoneHref,
    address: { "@type": "PostalAddress", streetAddress: site.address },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [...faqs.camping, ...camping.goodToKnow].map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<Layout title="Camping" description={description} schema={schema}>
  <PageHead
    kicker="The campsite"
    title="A meadow behind the kitchen, and a fire in the middle of it."
    lede="A handful of tents, one gate, and staff awake all night. Bring warm clothes; we handle the rest."
    image={images.pages.camping}
  />

  <section class="container-site py-16 md:py-24">
    <h2 class="text-sm font-semibold text-clay">Packages</h2>
    <ul class="mt-5 border-t border-ink/15">
      {camping.packages.map((p) => (
        <li class="border-b border-ink/15 py-6">
          <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
            <h3 class="font-display text-2xl">{p.name}</h3>
            <span class="text-sm text-ink-soft">{p.capacity}</span>
            <div class="grow border-b border-dotted border-ink/30"></div>
            <span class="font-display text-xl">{p.price}</span>
            <span class="text-xs text-ink-soft">{p.unit}</span>
          </div>
          <ul class="mt-2 flex flex-wrap gap-x-5 gap-y-1 text-sm text-ink-soft">
            {p.includes.map((inc) => <li>{inc}</li>)}
          </ul>
        </li>
      ))}
    </ul>

    <div class="mt-12 flex flex-wrap items-center gap-x-8 gap-y-4 border-t border-ink/15 pt-8">
      <a
        href={waLink(site.whatsappNumber, "Hi! I would like to book a campsite.")}
        class="border border-ink bg-ink px-6 py-3 text-sm font-semibold text-bone transition-colors hover:bg-transparent hover:text-ink"
      >
        Message us about camping
      </a>
      <a href={`tel:${site.phoneHref}`} class="text-sm font-semibold underline decoration-clay decoration-2 underline-offset-4 hover:text-clay">
        Or call {site.phoneDisplay}
      </a>
    </div>
  </section>

  <section class="container-site pb-16 md:pb-24">
    <h2 class="text-sm font-semibold text-clay">What is here</h2>
    <ul class="mt-5 grid gap-x-12 border-t border-ink/15 md:grid-cols-2">
      {camping.amenities.map((a) => (
        <li class="border-b border-ink/15 py-4 text-ink-soft">{a}</li>
      ))}
    </ul>
  </section>

  <section class="container-site pb-16 md:pb-24">
    <h2 class="text-sm font-semibold text-clay">Good to know</h2>
    <div class="mt-5 border-t border-ink/15">
      {camping.goodToKnow.map((f) => (
        <details class="group border-b border-ink/15">
          <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-6 py-5 text-left font-display text-lg md:text-xl [&::-webkit-details-marker]:hidden">
            {f.q}
            <svg viewBox="0 0 24 24" class="h-5 w-5 shrink-0 text-clay transition-transform group-open:rotate-45" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M12 5v14M5 12h14" />
            </svg>
          </summary>
          <p class="max-w-2xl pb-6 text-ink-soft">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <FaqSection faqs={faqs.camping} title="Camping questions" />
</Layout>
