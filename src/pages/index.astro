---
import Layout from "../layouts/Layout.astro";
import FaqSection from "../components/FaqSection.astro";
import site from "../data/site.json";
import menu from "../data/menu.json";
import images from "../data/images.json";
import faqs from "../data/faqs.json";
import { waLink } from "../lib/links";

const heroKicker = "Restaurant and campsite, hillside";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: site.name,
    url: Astro.site?.href,
  },
  {
    "@context": "https://schema.org",
    "@type": "Restaurant",
    name: site.name,
    description: site.tagline,
    telephone: site.phoneHref,
    email: site.email,
    servesCuisine: ["Pakistani", "Barbecue", "Mountain"],
    priceRange: "Rs 300 to Rs 2,000",
    acceptsReservations: "True",
    address: { "@type": "PostalAddress", streetAddress: site.address },
    openingHoursSpecification: site.hours.map((h) => ({
      "@type": "OpeningHoursSpecification",
      description: h.days,
      opens: "10:00",
      closes: "22:00",
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.home.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<Layout title={site.name} description={site.tagline} image={images.home.hero.src} schema={schema}>
  <!-- Hero: full-screen photo, nav sits over it. Left-aligned, no badge, one CTA. -->
  <section class="relative flex min-h-svh flex-col justify-end text-bone">
    <img
      src={images.home.hero.src}
      alt={images.home.hero.alt}
      class="absolute inset-0 h-full w-full object-cover"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-ink/50"></div>
    <div class="container-site relative pb-16 md:pb-24" data-motion-group>
      <p class="text-sm font-semibold text-clay">{heroKicker}</p>
      <h1 class="mt-4 max-w-4xl font-display text-[clamp(2.75rem,7vw,6rem)] font-medium leading-[1.02]">
        Cooked over fire.
        <br />
        Slept under stars.
      </h1>
      <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4">
        <a
          href={`tel:${site.phoneHref}`}
          class="border border-bone bg-bone px-6 py-3 text-sm font-semibold text-ink transition-colors hover:bg-transparent hover:text-bone"
        >
          Reserve a table · {site.phoneDisplay}
        </a>
        <a href={waLink(site.whatsappNumber, "Hi! I want to book a campsite.")} class="text-sm font-semibold underline decoration-clay decoration-2 underline-offset-4 hover:text-clay">
          Message us on WhatsApp
        </a>
      </div>
      <p class="mt-6 text-sm text-bone/70">{site.hours[0].days}: {site.hours[0].time}</p>
    </div>
  </section>

  <!-- Intro: asymmetric editorial split, not 50/50 cards -->
  <section class="container-site py-20 md:py-32">
    <div class="grid gap-12 md:grid-cols-12 md:gap-8">
      <div class="md:col-span-5">
        <h2 class="font-display text-3xl leading-tight md:text-4xl">
          A kitchen that takes its time, and a meadow that lets you.
        </h2>
      </div>
      <div class="md:col-span-4 md:col-start-7 md:pt-2">
        <p class="text-ink-soft">
          Native started as a kitchen on the family orchard, cooking for whoever was around the fire.
          The room is small and the menu is short, because the food is cooked the slow way: karahi that
          takes two hours, bread pulled to order, coffee boiled three times.
        </p>
        <p class="mt-4 text-ink-soft">
          Behind the kitchen, the meadow holds a handful of tents. Guests eat dinner downstairs and
          walk up to the fire. That is the whole business, and it is enough.
        </p>
      </div>
    </div>
    <div class="mt-14 grid gap-8 md:grid-cols-12">
      <img src={images.home.kitchen.src} alt={images.home.kitchen.alt} class="aspect-[4/3] w-full object-cover md:col-span-7" loading="lazy" />
      <img src={images.home.spread.src} alt={images.home.spread.alt} class="aspect-[4/3] w-full object-cover md:col-span-5 md:mt-16" loading="lazy" />
    </div>
  </section>

  <!-- Menu teaser: the signature hairline rows -->
  <section class="container-site pb-20 md:pb-32">
    <div class="flex items-baseline justify-between gap-6">
      <h2 class="font-display text-3xl md:text-4xl">From the fire</h2>
      <a href="/menu/" class="shrink-0 text-sm font-semibold text-clay underline decoration-2 underline-offset-4 hover:text-clay-deep">
        The full menu
      </a>
    </div>
    <ul class="mt-8 border-t border-ink/15">
      {menu.signature.map((item) => (
        <li class="border-b border-ink/15 py-5">
          <div class="flex items-baseline gap-4">
            <h3 class="font-display text-xl md:text-2xl">{item.name}</h3>
            <div class="grow border-b border-dotted border-ink/30"></div>
            <span class="font-display text-xl">{item.price}</span>
          </div>
          <p class="mt-1 max-w-2xl text-sm text-ink-soft">{item.description}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- Camping band: photo with quiet overlay text -->
  <section class="relative flex min-h-[70vh] items-end text-bone">
    <img src={images.home.campingBand.src} alt={images.home.campingBand.alt} class="absolute inset-0 h-full w-full object-cover" loading="lazy" />
    <div class="absolute inset-0 bg-ink/50"></div>
    <div class="container-site relative pb-14">
      <p class="text-sm font-semibold text-clay">Stay the night</p>
      <h2 class="mt-3 max-w-2xl font-display text-3xl leading-tight md:text-5xl">
        Tents, bonfires, and a sky with no streetlights.
      </h2>
      <a href="/camping/" class="mt-6 inline-block text-sm font-semibold underline decoration-clay decoration-2 underline-offset-4 hover:text-clay">
        Camping packages and booking
      </a>
    </div>
  </section>

  <!-- Gallery strip -->
  <section class="container-site py-20 md:py-28">
    <div class="flex items-baseline justify-between gap-6">
      <h2 class="font-display text-3xl md:text-4xl">The place, as it is</h2>
      <a href="/gallery/" class="shrink-0 text-sm font-semibold text-clay underline decoration-2 underline-offset-4 hover:text-clay-deep">
        All photos
      </a>
    </div>
    <div class="mt-10 grid grid-cols-2 gap-4 md:grid-cols-4 md:gap-6">
      {images.galleryStrip.map((img, i) => (
        <figure class:list={["", i % 2 === 1 && "md:mt-10"]}>
          <img src={img.src} alt={img.alt} class:list={["w-full object-cover", img.aspect]} loading="lazy" />
        </figure>
      ))}
    </div>
  </section>

  <FaqSection faqs={faqs.home} />

  <!-- Visit band -->
  <section class="bg-ink text-bone">
    <div class="container-site py-16 md:py-24">
      <h2 class="font-display text-3xl md:text-4xl">Come up</h2>
      <div class="mt-10 grid gap-10 md:grid-cols-2">
        <ul class="border-t border-bone/15 text-sm">
          {site.hours.map((h) => (
            <li class="flex items-baseline justify-between gap-4 border-b border-bone/15 py-4">
              <span class="font-display text-base">{h.days}</span>
              <span class="text-bone/80">{h.time}</span>
            </li>
          ))}
        </ul>
        <div class="flex flex-col justify-between gap-6">
          <ul class="text-sm">
            <li>
              <a href={`tel:${site.phoneHref}`} class="block border-b border-bone/15 py-4 font-display text-xl transition-colors hover:text-clay">
                {site.phoneDisplay}
              </a>
            </li>
            <li>
              <a href={waLink(site.whatsappNumber, "Hi Native!")} class="block border-b border-bone/15 py-4 font-display text-xl transition-colors hover:text-clay">
                WhatsApp
              </a>
            </li>
            <li>
              <span class="block border-b border-bone/15 py-4 text-bone/80">{site.address}</span>
            </li>
          </ul>
          <a
            href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.mapsQuery)}`}
            class="self-start border border-bone/60 px-6 py-3 text-sm font-semibold transition-colors hover:bg-bone hover:text-ink"
          >
            Get directions
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
