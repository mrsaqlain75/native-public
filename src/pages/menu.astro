---
import Layout from "../layouts/Layout.astro";
import PageHead from "../components/PageHead.astro";
import FaqSection from "../components/FaqSection.astro";
import site from "../data/site.json";
import menu from "../data/menu.json";
import images from "../data/images.json";
import faqs from "../data/faqs.json";
import { waLink } from "../lib/links";

const description = "The menu at Native: karahi and kebabs from the wood fire, bread from the tandoor, and kehwa by the pot. Prices current as of this month.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.menu.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<Layout title="The menu" description={description} image={images.pages.menu.src} schema={schema}>
  <PageHead
    kicker="The menu"
    title="Everything here meets a fire before it meets you."
    lede={menu.note.replace("Prices are placeholders. ", "")}
    image={images.pages.menu}
  />

  <section class="container-site py-16 md:py-24">
    {menu.categories.map((cat) => (
      <div class="mb-14 last:mb-0">
        <h2 class="text-sm font-semibold text-clay">{cat.name}</h2>
        <ul class="mt-5 border-t border-ink/15">
          {cat.items.map((item) => (
            <li class="border-b border-ink/15 py-5">
              <div class="flex items-baseline gap-4">
                <h3 class="font-display text-xl md:text-2xl">{item.name}</h3>
                <div class="grow border-b border-dotted border-ink/30"></div>
                <span class="font-display text-xl">{item.price}</span>
              </div>
              <p class="mt-1 max-w-2xl text-sm text-ink-soft">{item.description}</p>
            </li>
          ))}
        </ul>
      </div>
    ))}

    <div class="mt-12 flex flex-wrap items-center gap-x-8 gap-y-4 border-t border-ink/15 pt-8">
      <a
        href={`tel:${site.phoneHref}`}
        class="border border-ink bg-ink px-6 py-3 text-sm font-semibold text-bone transition-colors hover:bg-transparent hover:text-ink"
      >
        Call to order takeaway · {site.phoneDisplay}
      </a>
      <a href={waLink(site.whatsappNumber, "Hi! I would like to place an order.")} class="text-sm font-semibold underline decoration-clay decoration-2 underline-offset-4 hover:text-clay">
        Or message us on WhatsApp
      </a>
    </div>
  </section>

  <FaqSection faqs={faqs.menu} title="About the food" />
</Layout>
