---
import Layout from "../layouts/Layout.astro";
import PageHead from "../components/PageHead.astro";
import FaqSection from "../components/FaqSection.astro";
import site from "../data/site.json";
import menu from "../data/menu.json";
import images from "../data/images.json";
import faqs from "../data/faqs.json";
import { waLink } from "../lib/links";

const description = "The menu at Native: karahi and kebabs from the wood fire, trout from our own fish farm, bread from the tandoor, and kehwa by the pot.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.menu.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<Layout title="Our Menu" description={description} image={images.pages.menu.src} schema={schema}>
  <PageHead
    title="Our Menu"
    lede="Cooked to order: karahi from the fire, fish from our own ponds, burgers, pizza and wraps, and doodh patti by the pot."
    image={images.pages.menu}
  />

  <section class="container-site py-16 md:py-24">
    {menu.categories.map((cat) => (
      <div class="mb-20 last:mb-0">
        <div class="flex items-baseline justify-between gap-6 border-b border-ink/15 pb-3">
          <h2 class="font-display text-2xl md:text-3xl">{cat.name}</h2>
          <span class="text-sm text-ink-soft">{cat.items.length} {cat.items.length === 1 ? "dish" : "dishes"}</span>
        </div>

        <div class="mt-10 grid gap-x-10 gap-y-12 sm:grid-cols-2">
          {cat.items.map((item, i) => (
            <article class:list={["group", i % 2 === 1 && "sm:mt-10"]}>
              <img
                src={item.img}
                alt={`${item.name} at ${site.name}`}
                class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
                loading="lazy"
              />
              <div class="mt-4 flex items-baseline gap-3">
                <h3 class="font-display text-xl md:text-2xl">{item.name}</h3>
                <div class="grow border-b border-dotted border-ink/30"></div>
                {item.price && <span class="font-display text-lg text-clay">{item.price}</span>}
              </div>
              <p class="mt-1 max-w-md text-sm text-ink-soft">{item.description}</p>
            </article>
          ))}
        </div>
      </div>
    ))}

    <!-- Custom orders card: the kitchen also cooks to order, so point people at the phone -->
    <div class="mt-20 grid gap-6 bg-ink p-8 text-bone md:grid-cols-12 md:items-center md:gap-10 md:p-12">
      <div class="md:col-span-8">
        <h2 class="font-display text-2xl leading-tight md:text-3xl">Custom orders</h2>
        <p class="mt-3 max-w-xl text-bone/85">
          Apart from the menu, we cook to order — a bigger karahi for a group, dishes you don't see
          listed here, food packed for a trip or a family event. Tell us what you have in mind and
          we'll tell you what it takes.
        </p>
      </div>
      <div class="md:col-span-4 md:justify-self-end">
        <a
          href={`tel:${site.phoneHref}`}
          class="inline-block bg-clay px-7 py-3.5 text-sm font-semibold text-bone transition-colors hover:bg-clay-deep"
        >
          Call {site.phoneDisplay}
        </a>
      </div>
    </div>

    <div class="mt-16 flex flex-wrap items-center gap-x-5 gap-y-4 border-t border-ink/15 pt-10">
      <a
        href={`tel:${site.phoneHref}`}
        class="bg-clay px-7 py-3.5 text-sm font-semibold text-bone transition-colors hover:bg-clay-deep"
      >
        Call to order takeaway
      </a>
      <a
        href={waLink(site.whatsappNumber, "Hi! I would like to place an order.")}
        class="border border-ink/30 px-7 py-3.5 text-sm font-semibold text-ink transition-colors hover:border-ink hover:bg-ink hover:text-bone"
      >
        Message on WhatsApp
      </a>
    </div>
  </section>

  <FaqSection faqs={faqs.menu} title="About the food" />
</Layout>
